# Copy to .env (ignored by Git). Keep real values out of source control.
# With direnv, .envrc loads this file into your shell whenever you cd here (run `direnv allow` once).

# --- Local server (pnpm dev) ---
# Without a password the server only runs on 127.0.0.1 with admin / changeme.
ADMIN_USER=admin
ADMIN_PASSWORD=
# HOST=0.0.0.0   # reach it from phones on the same Wi-Fi (requires ADMIN_PASSWORD)
# PORT=4181
# DATA_FILE=data/store.json

# --- Cloudflare deploy (pnpm deploy) ---
# The same account and token as ../gas-tracker, ../settle-up or ../bxtn-dev works as is.
# Account: Workers Scripts Edit, Workers R2 Storage Edit.
# Zone bxtn.dev: DNS Edit, Zone Read, Workers Routes Edit.
# ADMIN_USER above is also the hosted login name. The hosted password is not read from
# this file: set it once with  pnpm exec sst secret set AdminPassword --stage prod < password.txt
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=
