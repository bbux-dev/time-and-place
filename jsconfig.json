{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["site/**/*.js", "infra/**/*.js", "server.mjs"],
  "exclude": ["**/*.test.js", "site/share-sw.js", "node_modules", ".sst"]
}
