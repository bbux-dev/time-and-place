{
  "name": "trip-planner",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "test": "pnpm test:unit && pnpm test:ui",
    "check": "tsc -p jsconfig.json && tsc -p jsconfig.worker.json && node scripts/check-syntax.mjs",
    "preflight": "node scripts/cloudflare.mjs",
    "verify": "node scripts/verify-hosted.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "prepare:site": "node scripts/prepare-site.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "sst": "4.17.2",
    "typescript": "7.0.2"
  }
}
